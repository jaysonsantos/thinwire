# Copy to .env for local direnv. Leave values empty in git.
# Never commit api_id, api_hash, session strings, bot tokens, or OAuth secrets.

# RUST_LOG=thinwire=info,thinwire_protocol=info

# Headless / CI: skip the OS keychain. Secrets stay in memory this process only.
# THINWIRE_KEYRING=memory

# Optional TDLib database directory for --features telegram-tdlib. Never commit it.
# THINWIRE_TDLIB_DIR=
